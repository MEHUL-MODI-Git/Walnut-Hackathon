# Walnut — live connector credentials.
# Everything runs without these: absent a credential each app falls back to seeded
# Meridian Health data and the full demo still works. Nothing here is committed.
#
# NOTHING IN THIS REPO READS THIS FILE. There is no load_dotenv() call anywhere in
# walnut/ or scripts/ — the code reads os.environ and nothing else. So paste what you
# have, then export it yourself:
#
#     set -a; source .env; set +a
#     ./.venv/bin/python scripts/smoke.py     # then: make stack
#
# smoke.py tells you within a minute whether each token actually works, and if not, why.

# ── GitHub ── github.com/settings/tokens → classic → tick `repo`
GITHUB_TOKEN=
GITHUB_REPO=owner/name

# ── Linear ── linear.app → Settings → Security & access → Personal API keys
# Sent as `Authorization: <key>` — bare, NOT `Bearer <key>`.
LINEAR_API_KEY=

# ── Notion ── notion.so/my-integrations → New integration → Internal Integration Secret
# THEN open each page → ⋯ → Connections → add the integration. Without that step Walnut
# connects successfully and sees an entirely empty workspace.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ── Slack ── api.slack.com/apps → your app → OAuth & Permissions → Bot User OAuth Token
# Needs channels:history, channels:read, chat:write. Slack returns HTTP 200 with
# ok:false when a scope is missing, so a wrong-scope token looks like a working one.
SLACK_BOT_TOKEN=

# ── Email ── an app password, never the account password (Gmail needs 2FA enabled)
EMAIL_HOST=imap.gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_USER=
EMAIL_PASSWORD=

# ── Lemma ── uselemma.ai — agent tracing. Absent these the tracer silently no-ops.
LEMMA_API_KEY=
LEMMA_PROJECT_ID=

# ── The mock internal hospital system (started by `make stack`)
DISPENSARY_URL=http://localhost:8900
