# Walnut — live connector credentials.
# Every one of these is optional: absent a credential the app falls back to its
# fixture, and the full three-act demo still runs. Nothing here is committed.

# Slack — bot token from a Slack app (xoxb-...)
SLACK_BOT_TOKEN=

# Linear — personal API key. Note: sent as `Authorization: <key>`, NOT `Bearer <key>`.
LINEAR_API_KEY=

# GitHub — classic PAT or fine-grained token with repo scope
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Notion — internal integration token (secret_...). Share the pages with the
# integration or it will see nothing and report an empty workspace.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Email — IMAP for reading, SMTP for the human-approved send.
# Use an app password, never the account password.
EMAIL_HOST=imap.gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_USER=
EMAIL_PASSWORD=

# Lemma — agent tracing. Absent these the tracer no-ops silently.
LEMMA_API_KEY=
LEMMA_PROJECT_ID=
